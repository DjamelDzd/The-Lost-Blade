[project]
title = The Lost Blade
version = 1.1.0
custom = 1

[display]
width = 1280
height = 720
high_dpi = 1
dynamic_orientation = 0
display_profiles = /builtins/render/default.display_profiles
fullscreen = 0
swap_interval = 1
samples = 0
update_frequency = 60

[bootstrap]
main_collection = /main/main.collectionc

[render]
render = /builtins/render/default.renderc

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[physics]
gravity_y = -1200
scale = 0.02
use_fixed_timestep = 1

[engine]
fixed_update_frequency = 60

[input]
game_binding = /input/game.input_bindingc

[gui]
safe_area_mode = both

[sprite]
subpixels = 0

[android]
package_name = com.djamel.thelostblade
version_code = 2
version_name = 1.1.0
immersive_mode = 1

[resource]
max_resources = 2048
