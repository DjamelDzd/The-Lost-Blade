-- The Lost Blade - polished controller
-- Gameplay is deliberately deterministic: the character controller uses a fixed
-- physics step, coyote time and jump buffering rather than frame-rate-dependent jumps.
local W, H = 1280, 720
local PLAYER_W, PLAYER_H = 64, 112
local STAND_H, SLIDE_H = 112, 68
local GRAVITY = -1650
local RUN_SPEED = 320
local GROUND_ACCEL = 2100
local AIR_ACCEL = 1250
local GROUND_FRICTION = 2600
local JUMP_SPEED = 625
local COYOTE = 0.105
local JUMP_BUFFER = 0.12
local MAX_FALL = -1050
local FIXED_DT = 1 / 60

local ANIMS = {
    idle = {"knight_idle_0.png","knight_idle_1.png","knight_idle_2.png","knight_idle_3.png"},
    run = {"knight_0.png","knight_1.png","knight_2.png","knight_3.png","knight_4.png","knight_5.png"},
    jump = {"knight_jump.png"},
    fall = {"knight_fall.png"},
    land = {"knight_land.png"},
    slide = {"knight_slide.png"},
    death = {"knight_death_0.png","knight_death_1.png","knight_death_2.png"},
    bored = {"knight_bored_0.png","knight_bored_1.png","knight_bored_2.png"},
    carry = {"knight_carry_0.png","knight_carry_1.png","knight_carry_2.png"},
}

local LEVELS = {
    {
        name = "I · THE GREEN DESCENT", bg = "level1_bg_factory", music = "level1_music",
        intro = "The blade fell beyond the old watchtower.\nOnly the descent remains.",
        platforms = {
            {x=130,y=58,w=380,h=32}, {x=435,y=152,w=175,h=32}, {x=655,y=246,w=185,h=32},
            {x=900,y=160,w=180,h=32}, {x=1115,y=58,w=300,h=32},
            {x=795,y=398,w=150,h=32, moving=true, amp=46, speed=1.2, axis="y"},
            {x=575,y=340,w=125,h=32, moving=true, amp=35, speed=1.6, axis="x"},
        },
        hazards={{x=510,y=76,w=88,h=32},{x=1068,y=76,w=88,h=32}},
        checkpoints={{x=690,y=278}},
        secrets={{x=835,y=456,name="RAVEN RELIC"}},
        goal={x=1195,y=125},
    },
    {
        name = "II · THE BROKEN CRYPT", bg = "level2_bg_factory", music = "level2_music",
        intro = "Beneath the ruined chapel, every stone remembers.\nDo not wake what guards the crypt.",
        platforms = {
            {x=110,y=58,w=220,h=32},{x=390,y=130,w=150,h=32},{x=620,y=220,w=160,h=32},
            {x=850,y=320,w=170,h=32},{x=1080,y=210,w=150,h=32},{x=1030,y=58,w=250,h=32},
            {x=450,y=360,w=120,h=32, moving=true, amp=38, speed=1.3, axis="y"},
            {x=705,y=445,w=115,h=32, moving=true, amp=55, speed=0.9, axis="x"},
        },
        hazards={{x=300,y=76,w=90,h=32},{x=540,y=148,w=80,h=32},{x=780,y=238,w=100,h=32},{x=980,y=338,w=90,h=32}},
        checkpoints={{x=620,y=252},{x=1015,y=242}},
        secrets={{x=500,y=420,name="CRYPT SIGIL"}},
        goal={x=1160,y=125},
    },
    {
        name = "III · DRAGONFALL", bg = "level3_bg_factory", music = "level3_music",
        intro = "At the bottom waits the truth beneath the legend.\nThe lost blade is close.",
        platforms = {
            {x=100,y=58,w=220,h=32},{x=360,y=145,w=140,h=32},{x=560,y=260,w=150,h=32},
            {x=760,y=150,w=150,h=32},{x=980,y=290,w=170,h=32},{x=1140,y=88,w=220,h=32},
            {x=650,y=430,w=120,h=32, moving=true, amp=28, speed=1.4, axis="y"},
            {x=820,y=510,w=130,h=32, moving=true, amp=65, speed=0.75, axis="x"},
        },
        hazards={{x=320,y=76,w=80,h=32},{x=500,y=163,w=90,h=32},{x=710,y=278,w=80,h=32},{x=910,y=168,w=90,h=32},{x=1130,y=122,w=80,h=32}},
        checkpoints={{x=760,y=182},{x=1010,y=332}},
        secrets={{x=690,y=485,name="DRAGON OATH"}},
        goal={x=1210,y=158}, final=true,
    }
}

local function clamp(v,a,b) return math.max(a,math.min(b,v)) end
local function move_toward(v,target,amount)
    if v < target then return math.min(v+amount,target) end
    if v > target then return math.max(v-amount,target) end
    return target
end
local function overlap(ax,ay,aw,ah,bx,by,bw,bh)
    return math.abs(ax-bx)*2 < aw+bw and math.abs(ay-by)*2 < ah+bh
end
local function set_image(self,name)
    go.set(self.player,"image",hash("/assets/"..name))
end
local function set_anim(self,name,fps,loop)
    if self.anim == name and not self.anim_force then return end
    self.anim=name; self.anim_frame=1; self.anim_clock=0; self.anim_loop=(loop~=false); self.anim_force=false
    set_image(self,ANIMS[name][1])
end
local function animate_player(self,dt)
    local frames=ANIMS[self.anim] or ANIMS.idle
    self.anim_clock=self.anim_clock+dt
    local frame_time=1/(self.anim_fps or 8)
    if #frames>1 and self.anim_clock>=frame_time then
        self.anim_clock=self.anim_clock-frame_time
        self.anim_frame=self.anim_frame+1
        if self.anim_frame>#frames then
            if self.anim_loop then self.anim_frame=1 else self.anim_frame=#frames end
        end
        set_image(self,frames[self.anim_frame])
    end
end

local function stop_music(self)
    for _,id in ipairs({"menu_music","level1_music","level2_music","level3_music"}) do sound.stop("#"..id) end
end
local function play_music(self,id)
    stop_music(self); sound.play("#"..id,{gain=0.20})
end
local function delete_spawned(self)
    for _,id in ipairs(self.spawned or {}) do if id then pcall(go.delete,id) end end
    self.spawned={}
    self.fx={}
end
local function spawn_fx(self,x,y,kind,count)
    count=count or 4
    for i=1,count do
        local id=factory.create("#pixel_fx_factory",vmath.vector3(x+math.random(-16,16),y+math.random(-4,7),3))
        self.fx[#self.fx+1]={id=id,x=x+math.random(-16,16),y=y+math.random(-4,7),vx=math.random(-55,55),vy=math.random(20,90),life=0.32+math.random()*0.25,kind=kind or "dust"}
    end
end
local function update_fx(self,dt)
    for i=#self.fx,1,-1 do
        local f=self.fx[i]; f.life=f.life-dt; f.vy=f.vy-260*dt; f.x=f.x+f.vx*dt; f.y=f.y+f.vy*dt
        if f.id then
            go.set_position(vmath.vector3(f.x,f.y,3),f.id)
            local s=clamp(f.life*3.2,0.2,1.2); go.set_scale(vmath.vector3(s,s,1),f.id)
        end
        if f.life<=0 then pcall(go.delete,f.id); table.remove(self.fx,i) end
    end
end
local function show_background(self,level)
    if self.bg_id then pcall(go.delete,self.bg_id) end
    local f=(level==0 and "menu_bg_factory" or LEVELS[level].bg)
    self.bg_id=factory.create("#"..f,vmath.vector3(640,360,-10))
end
local function level_intro(self,text,seconds)
    self.cutscene=true; self.cutscene_timer=seconds or 2.4
    msg.post("/ui#gui","cutscene",{text=text,visible=true})
end
local function platform_update(self,dt)
    self.level_time=self.level_time+dt
    for _,p in ipairs(self.spawned_platforms) do
        if p.moving then
            local phase=self.level_time*p.speed
            if p.axis=="x" then p.x=p.base_x+math.sin(phase)*p.amp else p.y=p.base_y+math.sin(phase)*p.amp end
            go.set_position(vmath.vector3(p.x,p.y,0),p.id)
        end
    end
end
local function reset_player(self,pos)
    self.player_pos=vmath.vector3(pos.x,pos.y,0); self.vel=vmath.vector3(0,0,0)
    self.on_ground=false; self.coyote=0; self.jump_buffer=0; self.slide=false
    go.set_position(self.player_pos,self.player); go.set_scale(vmath.vector3(0.62,0.62,1),self.player)
end
local function setup_level(self,level)
    delete_spawned(self)
    self.level=level; self.level_data=LEVELS[level]; self.level_time=0; self.paused=false; self.cutscene=false
    show_background(self,level)
    self.player=factory.create("#player_factory",vmath.vector3(100,170,2)); self.spawned[#self.spawned+1]=self.player
    self.player_pos=vmath.vector3(100,170,0); self.vel=vmath.vector3(0,0,0)
    self.spawned_platforms={}
    for _,src in ipairs(self.level_data.platforms) do
        local p={x=src.x,y=src.y,w=src.w,h=src.h,base_x=src.x,base_y=src.y,moving=src.moving,amp=src.amp,speed=src.speed,axis=src.axis}
        local f=(level==2 and "#dark_platform_factory") or "#platform_factory"
        p.id=factory.create(f,vmath.vector3(p.x,p.y,0)); self.spawned[#self.spawned+1]=p.id; self.spawned_platforms[#self.spawned_platforms+1]=p
    end
    for _,h in ipairs(self.level_data.hazards) do local id=factory.create("#hazard_factory",vmath.vector3(h.x,h.y,0)); self.spawned[#self.spawned+1]=id end
    for _,c in ipairs(self.level_data.checkpoints) do local id=factory.create("#checkpoint_factory",vmath.vector3(c.x,c.y,0)); self.spawned[#self.spawned+1]=id end
    for _,s in ipairs(self.level_data.secrets) do local id=factory.create("#coin_factory",vmath.vector3(s.x,s.y,0)); self.spawned[#self.spawned+1]=id end
    if level==3 then
        local sword=factory.create("#sword_factory",vmath.vector3(1170,190,0)); self.spawned[#self.spawned+1]=sword
        local skull=factory.create("#skull_factory",vmath.vector3(1170,110,0)); self.spawned[#self.spawned+1]=skull
    end
    self.checkpoint=vmath.vector3(100,170,0); self.lives=self.cheat and math.huge or 3; self.collected={}; self.anim=""; self.anim_fps=8; self.carrying_sword=false; self.carry_id=nil; self.idle_timer=0
    reset_player(self,self.checkpoint); set_anim(self,"idle",5,true); play_music(self,self.level_data.music)
    msg.post("/ui#gui","screen",{screen="game",level=level,name=self.level_data.name,lives=self.lives})
    level_intro(self,self.level_data.intro,2.5)
end
local function enter_menu(self)
    delete_spawned(self); if self.bg_id then pcall(go.delete,self.bg_id); self.bg_id=nil end
    show_background(self,0); stop_music(self); sound.play("#menu_music",{gain=0.18}); self.mode="menu"; self.level=0
    msg.post("/ui#gui","screen",{screen="menu"})
end
local function die(self)
    if self.mode=="dying" then return end
    self.mode="dying"; self.death_timer=0; self.vel=vmath.vector3(0,260,0); self.slide=false; set_anim(self,"death",6,false); sound.play("#death",{gain=0.55}); spawn_fx(self,self.player_pos.x,self.player_pos.y,"death",8)
end
local function respawn(self)
    if not self.cheat then self.lives=self.lives-1 end
    if self.lives<=0 then self.lives=3; self.checkpoint=vmath.vector3(100,170,0) end
    reset_player(self,self.checkpoint); set_anim(self,"land",10,false); self.mode="game"
    msg.post("/ui#gui","hud",{text=string.format("%s   •   %s lives   •   CHECKPOINT",self.level_data.name,self.cheat and "∞" or tostring(self.lives))})
end
local function finish_level(self)
    if self.level_data.final then
        self.mode="ending"; self.cutscene=true; self.carrying_sword=true; set_anim(self,"carry",5,true)
        self.carry_id=factory.create("#carried_sword_factory",vmath.vector3(self.player_pos.x+32,self.player_pos.y+28,3)); self.spawned[#self.spawned+1]=self.carry_id
        sound.play("#sword",{gain=0.65}); level_intro(self,"THE LOST BLADE\n\nThe knight raises the sword.\nThe dragon remains silent.\nThe kingdom will tell a better story.",4.8)
        self.ending_timer=5.0
    else
        sound.play("#checkpoint",{gain=0.55}); self.mode="transition"; self.transition_timer=2.6; msg.post("/ui#gui","ending",{text="CHAPTER COMPLETE\n\nThe descent continues..."})
    end
end
local function update_anim_state(self,dt)
    if self.mode=="dying" then self.anim_fps=7; animate_player(self,dt); return end
    if self.carrying_sword then self.anim_fps=5; set_anim(self,"carry",5,true); animate_player(self,dt); return end
    if self.slide then self.anim_fps=1; set_anim(self,"slide",1,false); animate_player(self,dt); return end
    if not self.on_ground then
        if self.vel.y>80 then self.anim_fps=1; set_anim(self,"jump",1,false) else self.anim_fps=1; set_anim(self,"fall",1,false) end
        animate_player(self,dt); return
    end
    if math.abs(self.vel.x)>45 then self.anim_fps=10; set_anim(self,"run",10,true); self.idle_timer=0
    else
        self.idle_timer=self.idle_timer+dt
        if self.idle_timer>6.0 then self.anim_fps=4; set_anim(self,"bored",4,true) else self.anim_fps=5; set_anim(self,"idle",5,true) end
    end
    animate_player(self,dt)
end
local function physics_step(self,dt)
    if self.mode~="game" or self.cutscene or self.paused then return end
    platform_update(self,dt)
    local input_x=(self.right and 1 or 0)-(self.left and 1 or 0)
    local target=input_x*RUN_SPEED
    local accel=self.on_ground and GROUND_ACCEL or AIR_ACCEL
    if input_x~=0 then self.vel.x=move_toward(self.vel.x,target,accel*dt) else self.vel.x=move_toward(self.vel.x,0,GROUND_FRICTION*dt) end
    if self.jump_buffer>0 then self.jump_buffer=self.jump_buffer-dt end
    if self.coyote>0 then self.coyote=self.coyote-dt end
    if self.slide_request and self.on_ground and math.abs(self.vel.x)>90 then self.slide=true; self.slide_timer=0.46; self.vel.x=(self.vel.x>=0 and 1 or -1)*420; self.slide_request=false; spawn_fx(self,self.player_pos.x,self.player_pos.y-45,"dust",5); sound.play("#slide",{gain=0.35}) end
    self.slide_request=false
    if self.jump_requested then self.jump_buffer=JUMP_BUFFER; self.jump_requested=false end
    if self.jump_buffer>0 and (self.on_ground or self.coyote>0) and not self.slide then
        self.vel.y=JUMP_SPEED; self.on_ground=false; self.coyote=0; self.jump_buffer=0; sound.play("#jump",{gain=0.42}); spawn_fx(self,self.player_pos.x,self.player_pos.y-48,"dust",4)
    end
    if self.slide then
        self.slide_timer=self.slide_timer-dt
        if self.slide_timer<=0 then self.slide=false end
    end
    self.vel.y=clamp(self.vel.y+GRAVITY*dt,MAX_FALL,1000)
    local old_x,old_y=self.player_pos.x,self.player_pos.y
    self.player_pos.x=self.player_pos.x+self.vel.x*dt
    local body_h=self.slide and SLIDE_H or STAND_H
    -- horizontal world bounds
    self.player_pos.x=clamp(self.player_pos.x,PLAYER_W/2,W-PLAYER_W/2)
    -- vertical movement
    self.player_pos.y=self.player_pos.y+self.vel.y*dt
    local landed=false
    for _,p in ipairs(self.spawned_platforms) do
        local top=p.y+p.h/2; local bottom_old=old_y-body_h/2; local bottom_new=self.player_pos.y-body_h/2
        local left=self.player_pos.x-PLAYER_W/2; local right=self.player_pos.x+PLAYER_W/2
        local pl=p.x-p.w/2; local pr=p.x+p.w/2
        if self.vel.y<=0 and bottom_old>=top-3 and bottom_new<=top and right>pl+4 and left<pr-4 then
            self.player_pos.y=top+body_h/2; self.vel.y=0; landed=true
            if not self.on_ground then spawn_fx(self,self.player_pos.x,self.player_pos.y-body_h/2,"land",3); sound.play("#land",{gain=0.32}) end
        end
    end
    if self.on_ground and not landed and self.vel.y<0 then self.coyote=COYOTE end
    self.on_ground=landed
    if self.player_pos.y < -90 then die(self); return end
    for _,h in ipairs(self.level_data.hazards) do
        local hy=h.y+8
        if overlap(self.player_pos.x,self.player_pos.y,PLAYER_W,body_h,h.x,hy,h.w,h.h) then die(self); return end
    end
    for i,c in ipairs(self.level_data.checkpoints) do
        if not self.collected["c"..i] and overlap(self.player_pos.x,self.player_pos.y,PLAYER_W,body_h,c.x,c.y+25,55,95) then
            self.collected["c"..i]=true; self.checkpoint=vmath.vector3(c.x,c.y+62,0); sound.play("#checkpoint",{gain=0.55}); spawn_fx(self,c.x,c.y+20,"spark",8)
            msg.post("/ui#gui","hud",{text="CHECKPOINT SAVED  •  "..self.level_data.name})
        end
    end
    for i,s in ipairs(self.level_data.secrets) do
        if not self.collected["s"..i] and overlap(self.player_pos.x,self.player_pos.y,PLAYER_W,body_h,s.x,s.y,52,80) then
            self.collected["s"..i]=true; sound.play("#secret",{gain=0.5}); spawn_fx(self,s.x,s.y,"spark",10)
            msg.post("/ui#gui","hud",{text="SECRET FOUND  ✦  "..s.name})
        end
    end
    local g=self.level_data.goal
    if overlap(self.player_pos.x,self.player_pos.y,PLAYER_W,body_h,g.x,g.y,90,160) then finish_level(self); return end
    go.set_position(self.player_pos,self.player)
    if self.carry_id then go.set_position(vmath.vector3(self.player_pos.x+34,self.player_pos.y+24,3),self.carry_id) end
    if self.vel.x<-10 then go.set_scale(vmath.vector3(-0.62,0.62,1),self.player) elseif self.vel.x>10 then go.set_scale(vmath.vector3(0.62,0.62,1),self.player) end
    update_anim_state(self,dt)
end
function init(self)
    self.mode="menu"; self.spawned={}; self.fx={}; self.cheat=false; self.left=false; self.right=false; self.idle_timer=0
    msg.post(".","acquire_input_focus"); msg.post("@render:","use_fixed_fit_projection"); enter_menu(self)
end
function update(self,dt)
    update_fx(self,dt)
    if self.mode=="menu" then return end
    if self.mode=="transition" then self.transition_timer=self.transition_timer-dt; if self.transition_timer<=0 then setup_level(self,self.level+1) end; return end
    if self.mode=="ending_done" then return end
    if self.mode=="ending" then
        update_anim_state(self,dt)
        if self.carry_id and self.player then go.set_position(vmath.vector3(self.player_pos.x+34,self.player_pos.y+24,3),self.carry_id) end
        self.ending_timer=(self.ending_timer or 5)-dt
        if self.ending_timer<=0 then self.mode="ending_done"; msg.post("/ui#gui","ending",{text="THE LOST BLADE\n\nThe kingdom will say he slew the dragon with one blow.\nHe never corrects them.\n\nTHE END\n\nCREATED BY DJAMEL"}) end
        return
    end
    if self.mode=="dying" then
        self.death_timer=self.death_timer+dt; self.player_pos.y=self.player_pos.y+self.vel.y*dt; self.vel.y=self.vel.y-900*dt; go.set_position(self.player_pos,self.player); go.set_rotation(vmath.quat_rotation_z(math.rad(self.death_timer*260)),self.player); update_anim_state(self,dt)
        if self.death_timer>=0.72 then respawn(self); go.set_rotation(vmath.quat(),self.player) end
        return
    end
    if self.cutscene then self.cutscene_timer=self.cutscene_timer-dt; if self.cutscene_timer<=0 then self.cutscene=false; msg.post("/ui#gui","cutscene",{visible=false}) end; return end
    if self.paused then return end
    self.accumulator=(self.accumulator or 0)+dt
    while self.accumulator>=FIXED_DT do self.accumulator=self.accumulator-FIXED_DT; physics_step(self,FIXED_DT) end
end
function on_input(self,action_id,action)
    if action_id==hash("left") then self.left=not action.released
    elseif action_id==hash("right") then self.right=not action.released
    elseif action_id==hash("jump") and action.pressed then self.jump_requested=true
    elseif action_id==hash("slide") and action.pressed then self.slide_request=true
    elseif action_id==hash("touch") and action.pressed and self.mode=="game" then
        if action.x<300 then self.left=true; self.right=false elseif action.x<600 then self.right=true; self.left=false elseif action.x>1010 then self.jump_requested=true else self.slide_request=true end
    elseif action_id==hash("touch") and action.released then self.left=false; self.right=false
    elseif action_id==hash("pause") and action.pressed then if self.mode=="game" then self.paused=not self.paused; msg.post("/ui#gui","paused",{paused=self.paused}) end
    elseif action_id==hash("restart") and action.pressed then if self.level>0 then setup_level(self,self.level) end
    elseif action_id==hash("menu") and action.pressed then enter_menu(self) end
end
function on_message(self,id,message,sender)
    if id==hash("start_game") then self.mode="game"; setup_level(self,1)
    elseif id==hash("menu") then enter_menu(self)
    elseif id==hash("move_left") then self.left=message.down
    elseif id==hash("move_right") then self.right=message.down
    elseif id==hash("jump") and message.down then self.jump_requested=true
    elseif id==hash("slide") and message.down then self.slide_request=true
    elseif id==hash("pause") and self.mode=="game" then self.paused=not self.paused; msg.post("/ui#gui","paused",{paused=self.paused})
    elseif id==hash("restart") and self.level>0 then setup_level(self,self.level)
    elseif id==hash("code") then
        if message.text=="Djamelistheking" then self.cheat=true; self.lives=math.huge; msg.post("/ui#gui","hud",{text="CODE ACCEPTED  •  ENDLESS LIVES"}) else msg.post("/ui#gui","hud",{text="Unknown code."}) end
    end
end
